# --- Виртуальные окружения и зависимости ---
.venv/
venv/
env/
*/venv/
*/env/

# --- Секреты и конфиги ---
.env
.env.local
.env.*.local

# --- Python байт-код и артефакты сборки ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
*.manifest
*.spec

# --- Сборка и пакеты ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# --- Базы данных (в том числе SQLite для локальной разработки) ---
*.sqlite3
db.sqlite3

# --- Логи и покрытие кода ---
*.log
.coverage
coverage.xml

# --- Тесты и CI/CD ---
.tox/
.nox/
htmlcov/
.pytest_cache/
.hypothesis/

# --- IDE и редакторы ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- ОС-специфичные файлы ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Django-специфичное ---
media/                 # ВАЖНО: не заливаем загруженные картинки/файлы
staticfiles/            # Если собираете статику локально — не коммитьте
migrations/*.pyc       # Байт-код миграций

# --- Фикстуры и тестовые данные (чтобы не улететь на прод) ---
fixtures.json
fixtures/*.json
test_data/

# --- Jupyter и прочее ---
.ipython/profile_default/history.sqlite
.local/share/jupyter/